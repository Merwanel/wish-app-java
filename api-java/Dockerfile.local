# Optional fast-iteration image (NOT used by docker-compose.yaml).
# Prefer Dockerfile for portfolio / clean CI builds.
#
# When to use:
#   1) cd api-java && mvn -DskipTests package
#   2) docker build -f Dockerfile.local -t wish-api-java:local .
#   3) Point compose at it only if you need a quicker rebuild loop, e.g.:
#        docker compose build --build-arg ...  OR temporarily set
#        dockerfile: Dockerfile.local under api-java.build
#
# Compose default remains Dockerfile (Maven multi-stage).
FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache curl
WORKDIR /app
RUN addgroup -S appgroup && adduser -S -G appgroup appuser
COPY target/api-java-0.0.1-SNAPSHOT.jar app.jar
USER appuser
EXPOSE 3000
ENTRYPOINT ["java", "-jar", "app.jar"]
