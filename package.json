{
    "name": "wish-list-app",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "pretest": "npm run build:schemas:dev",
        "test": "npm run -w angular-app test:headless",
        "build:dev": "npm run build:schemas:dev",
        "build:schemas:dev": "npm run -w packages/shared-schemas build:dev",
        "build:angular-app:dev": "npm run -w angular-app build",
        "build:scraper": "npm run -w services/image-scraper build",
        "test:scraper": "npm run -w services/image-scraper test",
        "dev": "npm run build:dev && npm run -w angular-app start"
    },
    "workspaces": [
        "packages/*",
        "services/*",
        "angular-app"
    ],
    "dependencies": {
        "concurrently": "^9.2.1"
    }
}
